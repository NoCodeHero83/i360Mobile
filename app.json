{
  "expo": {
    "name": "ilyrox",
    "slug": "ilyrox",
    "version": "1.0.3",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Icon-size.png",
    "userInterfaceStyle": "light",
  "scheme": [
      "ilyroxapp",
      "com.ilyrox.app"
    ],
    "splash": {
      "image": "./src/assets/Icon-size.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/fc0a5782-4733-40f7-9c7e-efa6d3550f31",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilyrox.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Ilyrox necesita acceder a tu galería para que puedas seleccionar fotos y videos al crear publicaciones, reels y propiedades, elegir tu foto de perfil y adjuntar archivos en mensajes."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.ilyrox.app.onesignal"
        ]
      },
      "associatedDomains": [
        "applinks:posts.ilyrox.com",
        "applinks:ilyrox.app",
        "applinks:*.ilyrox.app"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#FFFFFF",
      "translucent": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCMns7F3TjXiJ4oswwws0USAgum"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Icon-size.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ilyrox.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "posts.ilyrox.com"
            },
            {
              "scheme": "https",
              "host": "ilyrox.app",
              "pathPrefix": "/feed"
            },
            {
              "scheme": "https",
              "host": "ilyrox.app",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "ilyroxapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./src/assets/Icon-size.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/Icon-size.png",
          "dark": {
            "image": "./src/assets/Icon-size.png",
            "backgroundColor": "#FFFFFF"
          },
          "imageWidth": 200
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
          [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.293660725108-e0m6asno2r6d7umkk6im1pvg1dbdd8c2"
        }
      ],
      "expo-router",
      "expo-font",
      "react-native-compressor"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.ilyrox.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.ilyrox.app.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "fc0a5782-4733-40f7-9c7e-efa6d3550f31"
      },
      "router": {}
    },
    "owner": "imightbewrong"
  }
}
